{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ouro",
  "homepage": "https://github.com/ourostack/ouro-ui",
  "version": "0.1.0",
  "items": [
    {
      "name": "ouro-base",
      "type": "registry:item",
      "title": "Ouro base",
      "description": "What every Ouro UI component needs in the app's CSS: success and warning colors, a destructive foreground, the motion tokens, the press utility and the spinner keyframes.",
      "docs": "Ouro UI's base tokens are in your CSS. Your theme's values win: edit them like any shadcn variable.",
      "cssVars": {
        "light": {
          "destructive-foreground": "#ffffff",
          "success": "#157d3c",
          "success-foreground": "#ffffff",
          "warning": "#b05109",
          "warning-foreground": "#ffffff",
          "ouro-spring-duration": "750ms",
          "ouro-ease-spring": "linear(0, 0.0663, 0.2105, 0.3763, 0.5332, 0.6669, 0.7733, 0.8533, 0.9107, 0.9499, 0.9754, 0.9911, 1, 1.0044, 1.0061, 1.0062, 1.0055, 1.0045, 1.0035, 1.0026, 1.0018, 1.0012, 1.0008, 1, 1)",
          "ouro-duration-fast": "100ms",
          "ouro-duration-base": "200ms",
          "ouro-duration-slow": "400ms",
          "ouro-press-scale": "0.97",
          "ouro-backdrop-color": "#18181b",
          "ouro-backdrop-max": "0.4"
        },
        "dark": {
          "destructive-foreground": "#000000",
          "success": "#4ade80",
          "success-foreground": "#000000",
          "warning": "#fbbf24",
          "warning-foreground": "#000000",
          "ouro-backdrop-color": "#000000"
        },
        "theme": {
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)"
        }
      },
      "css": {
        "@utility press": {
          "transition": "scale var(--ouro-spring-duration) var(--ouro-ease-spring), background-color var(--ouro-duration-fast) ease-out, border-color var(--ouro-duration-fast) ease-out, color var(--ouro-duration-fast) ease-out, opacity var(--ouro-duration-fast) ease-out"
        },
        "@keyframes ouro-spin": {
          "to": {
            "rotate": "1turn"
          }
        },
        "@keyframes ouro-pulse": {
          "50%": {
            "opacity": "0.4"
          }
        }
      }
    },
