// Writes the default Ouro theme CSS to src/generated/theme.css and the Tailwind mapping to
// src/generated/tailwind-theme.css (both committed).
// `--check` exits 1 when a committed file is stale. `--out <path>` overrides the theme.css
// path; the mapping file is written beside it.
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { ouroTheme } from "../src/theme/ouro.ts";
import { tailwindThemeCss } from "../src/theme/tailwindMap.ts";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const args = process.argv.slice(2);
const outIndex = args.indexOf("--out");
const out = outIndex === -1 ? join(root, "src/generated/theme.css") : (args[outIndex + 1] ?? "");
const header = (source: string) =>
  `/* Generated by scripts/build-theme.mts from ${source}. Do not edit; run \`pnpm theme\`. */\n`;
const files = [
  { path: out, content: header("src/theme/ouro.ts") + ouroTheme.css },
  {
    path: join(dirname(out), "tailwind-theme.css"),
    content: header("src/theme/tailwindMap.ts") + tailwindThemeCss(),
  },
];

if (args.includes("--check")) {
  const stale = files.filter(
    (file) => (existsSync(file.path) ? readFileSync(file.path, "utf8") : "") !== file.content,
  );
  if (stale.length > 0) {
    console.error(`${stale.map((file) => file.path).join(", ")} is stale. Run \`pnpm theme\` and commit the result.`);
    process.exit(1);
  }
  console.log("Theme CSS is up to date.");
} else {
  mkdirSync(dirname(out), { recursive: true });
  for (const file of files) {
    writeFileSync(file.path, file.content);
    console.log(`Wrote ${file.path}`);
  }
}
