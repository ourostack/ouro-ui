// Writes the default Ouro theme CSS to src/generated/theme.css (committed).
// `--check` exits 1 when the committed file is stale. `--out <path>` overrides the file.
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { ouroTheme } from "../src/theme/ouro.ts";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const args = process.argv.slice(2);
const outIndex = args.indexOf("--out");
const out = outIndex === -1 ? join(root, "src/generated/theme.css") : (args[outIndex + 1] ?? "");
const header =
  "/* Generated by scripts/build-theme.mts from src/theme/ouro.ts. Do not edit; run `pnpm theme`. */\n";
const expected = header + ouroTheme.css;

if (args.includes("--check")) {
  const current = existsSync(out) ? readFileSync(out, "utf8") : "";
  if (current !== expected) {
    console.error(`${out} is stale. Run \`pnpm theme\` and commit the result.`);
    process.exit(1);
  }
  console.log("Theme CSS is up to date.");
} else {
  mkdirSync(dirname(out), { recursive: true });
  writeFileSync(out, expected);
  console.log(`Wrote ${out}`);
}
