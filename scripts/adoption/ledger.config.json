  "cards": [
    {
      "id": "current-ouro-ui-and-ax-kit",
      "title": "Spoonjoy web: current Ouro UI, and the MCP on the AX kit",
      "outcome": "Upgrade Ouro HX to the current tag, move the MCP onto the AX kit, and run `ax-xray` on it in CI with `must` claims passing.",
      "surfaces": [
        "spoonjoy-web"
      ]
    },
    {
      "id": "apple-hx-components-adoption",
      "title": "Spoonjoy Apple: OuroHX components instead of hand-built controls",
      "outcome": "Replace hand-built buttons, sheets, toasts and empty states with `OuroHX` components; raise the X-ray score and fix the entity-property failures.",
      "surfaces": [
        "spoonjoy-apple"
      ]
    },
    {
      "id": "gui-through-document-actions",
      "title": "Ouro MD: menus and toolbar through DocumentActions",
      "outcome": "Route menu and toolbar commands through `DocumentActions`, move to the current ouro-ui-apple, and raise the X-ray score.",
      "surfaces": [
        "ouro-md"
      ]
    },
    {
      "id": "gatefold-ouro-ui-adoption",
      "title": "Gatefold: Ouro HX and Ouro AX",
      "outcome": "Gatefold takes Ouro HX tokens and components, adds App Intents with Ouro AX, and goes up from 0 of 30 on the X-ray.",
      "surfaces": [
        "gatefold"
      ]
    },
    {
      "id": "ouro-cli-on-ax-kit",
      "title": "ouro CLI on the AX kit",
      "outcome": "Run the `ouro` CLI through the AX kit (or a claims-equivalent), run `ax-xray` in CI and publish its score.",
      "surfaces": [
        "harness"
      ]
    },
    {
      "id": "mailbox-ui-on-ouro-hx",
      "title": "Harness mailbox UI on Ouro HX",
      "outcome": "Replace the Catalyst copies in `packages/mailbox-ui` with Ouro HX components and tokens, and add Ouro check to its CI.",
      "surfaces": [
        "harness"
      ]
    },
    {
      "id": "desk-mcp-on-ax-kit",
      "title": "Desk MCP on the AX kit",
      "outcome": "Adopt `defineCommand` and `ax-mcp` for the Desk MCP tools beyond the vendored files, and run the X-ray against the MCP.",
      "surfaces": [
        "desk"
      ]
    },
    {
      "id": "factory-site-on-ouro-hx",
      "title": "Factory site on Ouro HX",
      "outcome": "Move the factory site onto Ouro HX tokens and components and run Ouro check in CI.",
      "surfaces": [
        "factory"
      ]
    },
    {
      "id": "own-clis-on-definecommand",
      "title": "Ouro UI's own CLIs on defineCommand",
      "outcome": "Build `ouro-check`, `ax-xray`, `ouro-images` and the flows runner with `defineCommand`, so the kit has a production user in its own repository.",
      "surfaces": [
        "ouro-ui"
      ]
    },
    {
      "id": "registry-agent-door",
      "title": "Registry and site agent door",
      "outcome": "Give the registry and the site an MCP or WebMCP door.",
      "surfaces": [
        "ouro-ui"
      ]
    },
    {
      "id": "go-and-swift-ax-paths",
      "title": "Go and plain-JS paths to Ouro AX",
      "outcome": "Decide how Go (m365crawl, crawlkit) and plain-JS CLIs adopt Ouro AX: a Go port of the kit, or black-box X-ray only.",
      "surfaces": [
        "m365crawl"
      ]
    },
    {
      "id": "adoption-ledger",
      "title": "This ledger",
      "outcome": "Publish the adoption table as a living page, with a give-back count per product and a check that flags a consumer whose pinned tag falls behind.",
      "surfaces": []
    },
    {
      "id": "housesitter-reins-shape-upstream",
      "title": "Housesitter gives its Reins shape back",
      "outcome": "Housesitter gives its `ls`/`do` shape back as a conformance test for the Reins protocol spec, and the X-ray checks it.",
      "surfaces": [
        "housesitter"
      ]
    },
    {
      "id": "ouroboros-site-current-ouro-ui",
      "title": "ouroboros.bot on current Ouro UI",
      "outcome": "Move `OURO_UI_TAG` to current and replace the raw `<button>` and `<input>` elements in 17 files with Ouro components.",
      "surfaces": [
        "ouroboros-website"
      ]
    },
    {
      "id": "rule-in-every-agents-md",
      "title": "The Ouro UI rule in every repository's AGENTS.md",
      "outcome": "Add the \"Interfaces follow Ouro UI\" rule to the AGENTS.md of every repository in the ledger that is silent today.",
      "surfaces": []
    }
  ],
