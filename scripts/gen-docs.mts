// Generates the docs (spec §4.9: docs live in the types) from the JSDoc and prop types in
// registry/, through the TypeScript compiler API:
//
// - docs/<Export>.md for every component, and docs/parts.md;
// - the catalog in README.md, between <!-- catalog:start --> and <!-- catalog:end -->, and its
//   item list, between <!-- items:start --> and <!-- items:end -->, from the component
//   manifests and lib/ouro;
// - site/src/docs/catalog.json, the site's page per registry item, and site/src/docs/pages.json,
//   its page per other documented export (Radio, OuroProvider) and per guide (docs/guides/*.md,
//   written by hand), so every docs page has an address: docs/<kebab-case name>; each with its
//   summary, so the docs index lists the pages without loading their Markdown;
// - README.md "Upgrading from v0.1.0", between <!-- upgrade:start --> and <!-- upgrade:end -->,
//   copied from UPGRADING.md with its {{latestRelease}} placeholder filled in;
// - the release tag in the install commands of README.md, site/public/llms.txt and
//   package.json's description: package.json's ouro.latestRelease (scripts/latest-release.mjs).
//
// `--check` exits 1 when a committed file differs from what would be generated.
// `--out <dir>` writes (or checks) under another root, for tests. Output is deterministic:
// sorted props, no timestamps.
import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import ts from "typescript";
import { fillPlaceholder, latestRelease, syncedFiles, withRelease } from "./latest-release.mjs";
import { noteBody } from "./upgrade-note.mjs";
import { APP_SETUP, groupOrder } from "./catalog-groups.mts";
import { componentsDir, pascal, readComponents } from "./components.mts";
import { summary } from "./docs-summary.mts";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const args = process.argv.slice(2);
const outIndex = args.indexOf("--out");
const outRoot = outIndex === -1 ? root : (args[outIndex + 1] ?? "");
const check = args.includes("--check");

const GENERATED = "<!-- Generated by scripts/gen-docs.mts from the JSDoc in registry/. Do not edit; run `pnpm run docs`. -->";

/**
 * Catalog groups, in catalog order: the component groups (scripts/catalog-groups.mts), then
 * "App setup". Each export names its group in its JSDoc (`@group Forms`); generation fails on
 * an export with no group or a group not listed there.
 */
const catalogGroups: string[] = [...groupOrder, APP_SETUP];
/** Groups whose entries are components an app composes; each must say what to use instead. */
const componentGroups = new Set<string>(groupOrder);

/** The components, in registry order, from each folder's component.json (scripts/components.mts). */
const components = readComponents(root);
/** The registry files whose exports are documented. A part file's parts are documented together on parts.md. */
const componentFiles = [
  ...components.map((entry) => `${componentsDir}${entry.folder}/${entry.stem}.tsx`),
  "registry/ouro/lib/ouro/ouro-provider.tsx",
  "registry/ouro/lib/ouro/toast.ts",
  "registry/ouro/lib/ouro/color-scheme.ts",
  "registry/ouro/lib/ouro/color-scheme-script.ts",
  "registry/ouro/lib/ouro/use-timer.ts",
  "registry/ouro/lib/ouro/feedback.ts",
  "registry/ouro/lib/ouro/share.ts",
  "registry/ouro/lib/ouro/use-install-prompt.ts",
];
/** Part files (`<folder>/<stem>-parts.tsx`), by the family their parts are named after (the stem in PascalCase). */
const partFiles: Record<string, string> = Object.fromEntries(
  [...new Set(components.map((entry) => entry.folder))].flatMap((folder) =>
    readdirSync(join(root, componentsDir, folder))
      .filter((file) => file.endsWith("-parts.tsx"))
      .map((file) => [pascal(file.replace(/-parts\.tsx$/, "")), `${componentsDir}${folder}/${file}`] as const),
  ),
);
/** The import path for a registry file, as written in the registry source. */
const importPath = (file: string) => `@/${file.replace(/\.tsx?$/, "")}`;

// ---------------------------------------------------------------------------------------
// The TypeScript program

const config = ts.getParsedCommandLineOfConfigFile(join(root, "tsconfig.json"), {}, {
  ...ts.sys,
  onUnRecoverableConfigFileDiagnostic: (diagnostic) => {
    throw new Error(ts.flattenDiagnosticMessageText(diagnostic.messageText, "\n"));
  },
});
if (!config) throw new Error("cannot read tsconfig.json");
const program = ts.createProgram(
  [...componentFiles, ...Object.values(partFiles)].map((file) => join(root, file)),
  config.options,
);
const checker = program.getTypeChecker();

const isOwn = (node: ts.Node) => !node.getSourceFile().fileName.includes("/node_modules/");

/** A file's exported symbols, without the ones tagged `@internal` (shared between registry files, not for apps). */
function exportsOf(file: string): ts.Symbol[] {
  const source = program.getSourceFile(join(root, file));
  const moduleSymbol = source && checker.getSymbolAtLocation(source);
  if (!moduleSymbol) throw new Error(`cannot read the exports of ${file}`);
  return checker
    .getExportsOfModule(moduleSymbol)
    .map((symbol) => (symbol.flags & ts.SymbolFlags.Alias ? checker.getAliasedSymbol(symbol) : symbol))
    .filter((symbol) => !symbol.getJsDocTags(checker).some((item) => item.name === "internal"));
}

/** Exported type aliases and interfaces declared in registry/, by name, for the "Types" sections. */
const ownTypes = new Map<string, ts.TypeAliasDeclaration | ts.InterfaceDeclaration>();
for (const source of program.getSourceFiles()) {
  if (!isOwn(source) || !/^registry\//.test(source.fileName.slice(root.length + 1))) continue;
  for (const statement of source.statements) {
    if (
      (ts.isTypeAliasDeclaration(statement) || ts.isInterfaceDeclaration(statement)) &&
      statement.modifiers?.some((modifier) => modifier.kind === ts.SyntaxKind.ExportKeyword)
    ) {
      ownTypes.set(statement.name.text, statement);
    }
  }
}

// ---------------------------------------------------------------------------------------
// JSDoc

/** Turns `{@link X}` into `X` in code, and joins JSDoc display parts into text. */
function docText(parts: ts.SymbolDisplayPart[] | undefined): string {
  return ts
    .displayPartsToString(parts)
    .replace(/\{@link(?:code|plain)?\s+([^}\s|]+)(?:[\s|]+([^}]*))?\}/g, (_, name: string, label?: string) => `\`${label?.trim() || name}\``)
    .trim();
}

function tag(symbol: ts.Symbol, name: string): string | undefined {
  const found = symbol.getJsDocTags(checker).filter((item) => item.name === name);
  return found.length === 0 ? undefined : found.map((item) => docText(item.text)).join("\n");
}

/** Joins hard-wrapped lines into paragraphs. */
function paragraphs(text: string): string[] {
  return text
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.replace(/\s*\n\s*/g, " ").trim())
    .filter(Boolean);
}

/** Splits a paragraph into sentences, never inside backticks. */
function sentences(paragraph: string): string[] {
  const out: string[] = [];
  let current = "";
  let inCode = false;
  for (let index = 0; index < paragraph.length; index++) {
    const char = paragraph[index]!;
    current += char;
    if (char === "`") inCode = !inCode;
    if (!inCode && /[.!?]/.test(char) && (index === paragraph.length - 1 || /\s/.test(paragraph[index + 1]!))) {
      const next = paragraph.slice(index + 1).trimStart()[0];
      if (next === undefined || /[A-Z`<]/.test(next)) {
        out.push(current.trim());
        current = "";
      }
    }
  }
  if (current.trim()) out.push(current.trim());
  return out;
}

interface Described {
  name: string;
  /** The first paragraph. */
  purpose: string;
  /** The first sentence: the catalog line. */
  summary: string;
  /** Paragraphs after the first, without their "use X instead" sentences. */
  usage: string[];
  /** Sentences after the first paragraph that say what to use instead. */
  instead: string[];
  example: string | undefined;
}

function describe(symbol: ts.Symbol): Described {
  const name = symbol.getName();
  const [purpose = "", ...rest] = paragraphs(docText(symbol.getDocumentationComment(checker)));
  if (!purpose) throw new Error(`${name} has no JSDoc. Every export needs a one-line purpose.`);
  // "Use X instead when…" is redirect guidance; "instead of" is not.
  const redirects = (sentence: string) => /\binstead\b(?! of\b)/.test(sentence);
  return {
    name,
    purpose,
    summary: sentences(purpose)[0]!,
    usage: rest
      .map((paragraph) => sentences(paragraph).filter((sentence) => !redirects(sentence)).join(" "))
      .filter(Boolean),
    instead: rest.flatMap(sentences).filter(redirects),
    example: tag(symbol, "example"),
  };
}

// ---------------------------------------------------------------------------------------
// Props

interface Prop {
  name: string;
  required: boolean;
  type: string;
  default: string | undefined;
  description: string;
  /** Typed `never`: a guard prop that redirects to the real one. */
  guard: boolean;
  declaration: ts.Declaration;
}

const literal = (type: ts.Type) =>
  type.isLiteral() || (type.flags & (ts.TypeFlags.BooleanLiteral | ts.TypeFlags.Undefined)) !== 0;

/**
 * A type-error hint: an object type whose only properties are typed `never`, such as
 * `{ 'Use <Button loading>': never }`. Nothing is assignable to it, so a prop typed
 * with one is a guard, and a union member `string & { … }` only names the fix.
 */
function isHint(type: ts.Type): boolean {
  if (type.isIntersection()) return type.types.some(isHint);
  const props = type.flags & ts.TypeFlags.Object ? checker.getPropertiesOfType(type) : [];
  return props.length > 0 && props.every((prop) => checker.getTypeOfSymbol(prop).flags & ts.TypeFlags.Never);
}

/** A prop's type as written, with literal unions spelled out and `| undefined` dropped. */
function typeText(symbol: ts.Symbol, declaration: ts.Declaration): string {
  const type = checker.getTypeOfSymbolAtLocation(symbol, declaration);
  const values = type.isUnion() ? type.types.filter((member) => !isHint(member)) : [];
  if (values.length > 0 && values.every(literal)) {
    const members = values.filter((member) => !(member.flags & ts.TypeFlags.Undefined));
    const names = members.map((member) => checker.typeToString(member));
    if (names.includes("true") && names.includes("false")) {
      return ["boolean", ...names.filter((name) => name !== "true" && name !== "false")].join(" | ");
    }
    return names.join(" | ");
  }
  const node = (declaration as { type?: ts.TypeNode }).type;
  const text = node ? node.getText() : checker.typeToString(checker.getNonNullableType(type));
  return text.replace(/\s*\|\s*undefined$/, "").replace(/\s+/g, " ");
}

function propOf(symbol: ts.Symbol): Prop | undefined {
  // An intersection can declare a prop twice (React's `href` and Button's own); ours documents it.
  const declaration = symbol.declarations?.find(isOwn);
  if (!declaration) return undefined;
  const type = checker.getTypeOfSymbolAtLocation(symbol, declaration);
  return {
    name: symbol.getName(),
    required: (symbol.flags & ts.SymbolFlags.Optional) === 0,
    type: typeText(symbol, declaration),
    default: tag(symbol, "default"),
    description:
      paragraphs(docText(symbol.getDocumentationComment(checker))).join(" ") ||
      (symbol.getName() === "ref" ? "Reaches the rendered element." : ""),
    // `prop?: never` reads as `undefined`; without the undefined it is `never` or a hint.
    guard: (checker.getNonNullableType(type).flags & ts.TypeFlags.Never) !== 0 || isHint(checker.getNonNullableType(type)),
    declaration,
  };
}

/** React interfaces whose attributes a props type passes through, e.g. `ButtonHTMLAttributes`. */
function nativeAttributes(type: ts.Type): string[] {
  const names = new Set<string>();
  for (const symbol of checker.getPropertiesOfType(type)) {
    const parent = symbol.declarations?.[0]?.parent;
    if (parent && !isOwn(parent) && ts.isInterfaceDeclaration(parent) && /HTMLAttributes$/.test(parent.name.text)) {
      names.add(parent.name.text);
    }
  }
  return [...names].sort();
}

interface Mode {
  /** For example "With trigger", from the alias name, or "With `lines`". */
  label: string;
  native: string[];
  alias: string | undefined;
  description: string;
  props: Prop[];
  excluded: Prop[];
}

interface PropsDoc {
  typeName: string;
  common: Prop[];
  guards: Prop[];
  modes: Mode[];
  native: string[];
}

const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name, "en");

function words(identifier: string): string {
  const spaced = identifier.replace(/([a-z])([A-Z])/g, "$1 $2");
  return spaced.charAt(0).toUpperCase() + spaced.slice(1).toLowerCase();
}

function propsDoc(component: string, parameter: ts.ParameterDeclaration): PropsDoc {
  const type = checker.getTypeAtLocation(parameter);
  const typeName = parameter.type?.getText() ?? checker.typeToString(type);
  const branches = type.isUnion() ? type.types : [type];
  const propsOfBranch = branches.map((branch) =>
    checker.getPropertiesOfType(branch).flatMap((symbol) => propOf(symbol) ?? []),
  );
  const sameEverywhere = (prop: Prop) =>
    propsOfBranch.every((props) => props.some((other) => other.name === prop.name && other.declaration === prop.declaration));
  const shared = propsOfBranch[0]!.filter(sameEverywhere);
  const modes = branches.map((branch, index): Mode => {
    const own = propsOfBranch[index]!.filter((prop) => !sameEverywhere(prop));
    const alias = branch.aliasSymbol?.getName();
    const unique = own.filter((prop) => !prop.guard && prop.name !== "ref").map((prop) => `\`${prop.name}\``);
    return {
      label: alias ? words(alias.replace(new RegExp(`^${component}`), "").replace(/Props$/, "")) : `With ${unique.join(" and ")}`,
      alias,
      description: branch.aliasSymbol ? paragraphs(docText(branch.aliasSymbol.getDocumentationComment(checker))).join(" ") : "",
      native: nativeAttributes(branch),
      props: own.filter((prop) => !prop.guard).sort(byName),
      excluded: own.filter((prop) => prop.guard).sort(byName),
    };
  });
  return {
    typeName,
    common: shared.filter((prop) => !prop.guard).sort(byName),
    guards: shared.filter((prop) => prop.guard).sort(byName),
    modes: branches.length > 1 ? modes.sort((a, b) => a.label.localeCompare(b.label, "en")) : [],
    // Native attributes are listed once when every mode takes the same, otherwise per mode.
    native: modes.every((mode) => mode.native.join() === modes[0]!.native.join()) ? modes[0]!.native : [],
  };
}

// ---------------------------------------------------------------------------------------
// Markdown

const cell = (text: string) => text.replace(/\|/g, "\\|").replace(/\n/g, " ");
const code = (text: string) => (text.includes("`") ? `\`\` ${text} \`\`` : `\`${text}\``);

function propTable(props: Prop[]): string {
  const rows = props.map(
    (prop) =>
      `| \`${prop.name}\`${prop.required ? " (required)" : ""} | ${cell(code(prop.type))} | ${prop.default ? cell(defaultText(prop.default)) : ""} | ${cell(prop.description)} |`,
  );
  return ["| Prop | Type | Default | Description |", "| --- | --- | --- | --- |", ...rows].join("\n");
}

/** `@default "accent"` reads as code, `@default derived from …` stays prose, and a value with a note keeps both. */
function defaultText(value: string): string {
  const match = /^("[^"]*"|'[^']*'|\d[\w.]*|true|false)(.*)$/s.exec(value);
  return match ? `${code(match[1]!)}${match[2]}` : value;
}

const nativeLine = (names: string[]) =>
  `Also accepts the attributes in React's ${names.map((name) => `\`${name}\``).join(" and ")} (\`id\`, \`aria-*\`, event handlers), passed to the rendered element, except those named on this page.`;

/** "A, B and C". */
const listOf = (items: string[]) => (items.length < 2 ? items.join("") : `${items.slice(0, -1).join(", ")} and ${items.at(-1)}`);
const list = (items: string[]) => items.map((item) => `- ${item}`).join("\n");

/** Exported registry types named in the given text, and the ones their definitions name, in order. */
function referencedTypes(texts: string[], skip: Set<string>): Array<ts.TypeAliasDeclaration | ts.InterfaceDeclaration> {
  const found = new Map<string, ts.TypeAliasDeclaration | ts.InterfaceDeclaration>();
  const queue = [...texts];
  while (queue.length > 0) {
    const text = queue.shift()!;
    for (const [name, declaration] of ownTypes) {
      if (found.has(name) || skip.has(name) || !new RegExp(`\\b${name}\\b`).test(text)) continue;
      found.set(name, declaration);
      queue.push(declaration.getText());
    }
  }
  return [...found.values()].sort((a, b) => a.name.text.localeCompare(b.name.text, "en"));
}

function typesSection(texts: string[], skip: Set<string>): string {
  const types = referencedTypes(texts, skip);
  if (types.length === 0) return "";
  const blocks = types.map((declaration) => {
    const symbol = checker.getSymbolAtLocation(declaration.name)!;
    const doc = paragraphs(docText(symbol.getDocumentationComment(checker))).join(" ");
    const definition = declaration
      .getText()
      .replace(/^\/\*\*[\s\S]*?\*\/\s*/, "")
      .replace(/^export\s+/, "");
    return `### \`${declaration.name.text}\`\n\n${doc ? `${doc}\n\n` : ""}\`\`\`ts\n${definition}${ts.isTypeAliasDeclaration(declaration) && !definition.endsWith(";") ? ";" : ""}\n\`\`\``;
  });
  return `## Types\n\n${blocks.join("\n\n")}`;
}

const classNameRule = (hasAlign: boolean, isToaster: boolean) =>
  [
    "## `className` is for layout only",
    "",
    "Pass margins, width and grid placement (`mt-4`, `w-full`, `col-span-2`). Your classes always win over Ouro UI's: each component merges `className` last with `cn` (tailwind-merge), so a class that conflicts with the component's own replaces it.",
    "",
    (isToaster
      ? "Toast appearance comes from each toast's `tone` and shared theme tokens, not viewport classes. In development, an appearance class warns once per Toaster instance with the theme-token fix. "
      : "Appearance comes from props, not classes. In development, a class that sets appearance logs one warning per component instance, naming the prop to use instead. ") +
      "A class sets appearance when, after its variants (`hover:`, `sm:`) and any `!` are removed, it starts with `bg-`, `text-`, `border-`, `rounded-`, `shadow-`, `font-`, `ring-`, `from-`, `via-`, `to-`, `fill-` or `stroke-`, or is `border`, `rounded`, `shadow` or `ring`, or has a `dark:` variant. Text wrapping, overflow and table layout classes (`text-wrap`, `text-ellipsis`, `border-collapse`) are layout and do not warn.",
    "",
    isToaster
      ? "Alignment classes (`text-center`) warn too: Toaster owns toast-content alignment. Use `<Toaster />` without the alignment class; a parent wrapper cannot align its portaled content."
      : hasAlign
      ? "Alignment classes (`text-center`) warn too: use the `align` prop."
      : "Alignment classes (`text-center`) warn too: set alignment on a parent element.",
  ].join("\n");

// ---------------------------------------------------------------------------------------
// Pages

interface Page {
  name: string;
  /** The registry file that exports it. */
  file: string;
  described: Described;
  group: string;
}

function header(name: string, described: Described, file: string): string {
  return `${GENERATED}\n\n# ${name}\n\n${described.purpose}\n\n\`\`\`tsx\nimport { ${name} } from "${importPath(file)}";\n\`\`\``;
}

function exampleSection(described: Described): string {
  if (!described.example) throw new Error(`${described.name} has no @example. Every export needs a minimal example.`);
  return `## Example\n\n\`\`\`tsx\n${described.example}\n\`\`\``;
}

function guidanceSections(described: Described, required: boolean): string[] {
  if (required && described.instead.length === 0) {
    throw new Error(`${described.name}'s JSDoc has no "use X instead when" sentence.`);
  }
  return [
    described.usage.length > 0 ? `## Usage\n\n${described.usage.join("\n\n")}` : "",
    described.instead.length > 0 ? `## Use instead when\n\n${list(described.instead)}` : "",
  ];
}

function functionDeclaration(symbol: ts.Symbol): ts.FunctionDeclaration {
  const declaration = symbol.declarations?.find(ts.isFunctionDeclaration);
  if (!declaration) throw new Error(`${symbol.getName()} is not a function declaration`);
  return declaration;
}

function componentPage(page: Page, symbol: ts.Symbol, partFamilies: Set<string>): string {
  const parameter = functionDeclaration(symbol).parameters[0];
  const sections = [header(page.name, page.described, page.file), exampleSection(page.described)];
  sections.push(...guidanceSections(page.described, componentGroups.has(page.group)));
  const texts: string[] = [];
  if (parameter) {
    const doc = propsDoc(page.name, parameter);
    const all = [...doc.common, ...doc.modes.flatMap((mode) => mode.props)];
    texts.push(...all.map((prop) => prop.type));
    sections.push(`## Props\n\n${doc.modes.length > 0 ? "Props every mode takes. " : ""}Type: \`${doc.typeName}\`.\n\n${propTable(doc.common)}`);
    if (doc.modes.length > 0) {
      const modes = doc.modes.map((mode) =>
        [
          `### ${mode.label}${mode.alias ? `: \`${mode.alias}\`` : ""}`,
          mode.description,
          mode.props.length > 0 ? propTable(mode.props) : "",
          doc.native.length === 0 && mode.native.length > 0 ? nativeLine(mode.native) : "",
          mode.excluded.length > 0
            ? `Not in this mode (typed \`never\`):\n\n${list(mode.excluded.map((prop) => `\`${prop.name}\`: ${prop.description}`))}`
            : "",
        ]
          .filter(Boolean)
          .join("\n\n"),
      );
      sections.push(
        `## Modes\n\n\`${doc.typeName}\` is a union: pass the props of exactly one mode. Mixing them is a type error.\n\n${modes.join("\n\n")}`,
      );
    }
    if (doc.native.length > 0) sections.push(`## Native attributes\n\n${nativeLine(doc.native)}`);
    if (doc.guards.length > 0) {
      sections.push(
        `## Don't use\n\nThese are not props. Passing one fails the type check with the fix in the error, and in development a console message names the fix.\n\n${list(doc.guards.map((prop) => `\`${prop.name}\`: ${prop.description}`))}`,
      );
    }
    if (all.some((prop) => prop.name === "className")) {
      sections.push(classNameRule(all.some((prop) => prop.name === "align"), page.name === "Toaster"));
    }
  }
  if (partFamilies.has(page.name)) {
    const hasRoot = exportsOf(partFiles[page.name]!).some((symbol) => symbol.getName() === `${page.name}Root`);
    sections.push(
      `## Parts\n\n${hasRoot ? "When these props cannot express your layout, build it from" : "For what these props cannot express, pass as children"} the parts in \`${importPath(partFiles[page.name]!)}\`. See [parts.md](parts.md#${page.name.toLowerCase()}-parts) for the required nesting.`,
    );
  }
  sections.push(typesSection(texts, new Set([page.name])));
  return `${sections.filter(Boolean).join("\n\n")}\n`;
}

function functionPage(page: Page, symbol: ts.Symbol): string {
  const declaration = functionDeclaration(symbol);
  const sections = [header(page.name, page.described, page.file), exampleSection(page.described)];
  sections.push(...guidanceSections(page.described, false));
  const parameters = declaration.parameters.map((parameter) => ({
    name: parameter.name.getText(),
    type: parameter.type?.getText() ?? "",
    initializer: parameter.initializer?.getText(),
  }));
  const rows = parameters.map(
    (parameter) => `| \`${parameter.name}\` | ${cell(code(parameter.type))} | ${parameter.initializer ? cell(code(parameter.initializer)) : ""} |`,
  );
  sections.push(`## Parameters\n\n| Parameter | Type | Default |\n| --- | --- | --- |\n${rows.join("\n")}`);
  const returns = declaration.type?.getText();
  if (returns) sections.push(`## Returns\n\n\`${returns}\``);
  sections.push(typesSection([...parameters.map((parameter) => parameter.type), returns ?? ""], new Set()));
  return `${sections.filter(Boolean).join("\n\n")}\n`;
}

const PARTS_INTRO = [
  "Building-block parts for the rare case where a component's props cannot express what you need. Prefer the props-first components.",
  "Each part checks that it sits inside its root and, in development, throws a message with the JSX it belongs in.",
].join("\n\n");

function partsPage(families: string[]): string {
  const sections = [`${GENERATED}\n\n# Parts\n\n${PARTS_INTRO}`];
  for (const family of families) {
    const members = exportsOf(partFiles[family]!)
      .filter((symbol) => symbol.declarations?.some(ts.isFunctionDeclaration) && symbol.getName().startsWith(family))
      .sort((a, b) => a.getName().localeCompare(b.getName(), "en"));
    // A family with a root (`DialogRoot`) rebuilds the component; one without (`SelectItem`)
    // goes inside the component itself as children, and its first part's example shows how.
    const rootPart = members.find((symbol) => symbol.getName() === `${family}Root`);
    const root = rootPart ? `${family}Root` : family;
    const rootDoc = describe(rootPart ?? members[0]!);
    if (!rootDoc.example) throw new Error(`${rootDoc.name} has no @example showing the required nesting.`);
    const rows = members.map((symbol) => {
      const text = paragraphs(docText(symbol.getDocumentationComment(checker))).join(" ").replace(/^Part: /, "");
      return `| \`${symbol.getName()}\` | ${cell(text.charAt(0).toUpperCase() + text.slice(1))} |`;
    });
    sections.push(
      [
        `## ${family} parts`,
        rootPart ? rootDoc.purpose.replace(/^Part: /, "").replace(/^./, (first) => first.toUpperCase()) : `Children of \`<${family}>\`, for what its props cannot express.`,
        `\`\`\`tsx\nimport {\n${members.map((symbol) => `  ${symbol.getName()},`).join("\n")}\n} from "${importPath(partFiles[family]!)}";\n\`\`\``,
        `### Required nesting`,
        `\`\`\`tsx\n${rootDoc.example}\n\`\`\``,
        `Each part checks that it sits inside \`<${root}>\`. Outside it, a part throws in development with a message that shows this JSX shape.`,
        `| Part | What it is |\n| --- | --- |\n${rows.join("\n")}`,
      ].join("\n\n"),
    );
  }
  return `${sections.join("\n\n")}\n`;
}

// ---------------------------------------------------------------------------------------
// Assemble

const pages: Page[] = [];
const symbols = new Map<string, ts.Symbol>();
for (const file of componentFiles) {
  for (const symbol of exportsOf(file)) {
    if (!symbol.declarations?.some(ts.isFunctionDeclaration)) continue;
    const name = symbol.getName();
    const group = tag(symbol, "group");
    if (!group) {
      throw new Error(`${name} is exported from ${file} but has no catalog group. Add \`@group <${catalogGroups.join(" | ")}>\` to its JSDoc, or tag it @internal.`);
    }
    if (!catalogGroups.includes(group)) throw new Error(`${name}'s @group ${group} is not a catalog group: use one of ${catalogGroups.join(", ")} (groupOrder in scripts/catalog-groups.mts).`);
    pages.push({ name, file, described: describe(symbol), group });
    symbols.set(name, symbol);
  }
}
// Catalog order: by group, then by name.
pages.sort((a, b) => catalogGroups.indexOf(a.group) - catalogGroups.indexOf(b.group) || a.name.localeCompare(b.name, "en"));

const partFamilies = pages.map((page) => page.name).filter((name) => partFiles[name] !== undefined);

const outputs = new Map<string, string>();
for (const page of pages) {
  const symbol = symbols.get(page.name)!;
  const isComponent = /^[A-Z]/.test(page.name);
  outputs.set(`docs/${page.name}.md`, isComponent ? componentPage(page, symbol, new Set(partFamilies)) : functionPage(page, symbol));
}
outputs.set("docs/parts.md", partsPage(partFamilies));
/**
 * The functions a component's site page documents too: a lowercase export in a component
 * group whose `@see` is that page, such as `toast` (lib/ouro/toast.ts) on docs/toaster.
 */
const pageFunctions = (item: string) =>
  pages
    .filter((page) => /^[a-z]/.test(page.name) && componentGroups.has(page.group) && (tag(symbols.get(page.name)!, "see") ?? "").endsWith(`/docs/${item}`))
    .map((page) => page.name);
// The site's docs pages (site/src/docs/items.ts): every component, by group, in registry order within a group,
// App setup's components (Inspector) last.
const groupOf = new Map(pages.map((page) => [page.name, page.group]));
const siteItems = components
  .filter((entry) => catalogGroups.includes(groupOf.get(entry.title) ?? ""))
  .map((entry) => ({
    name: entry.name,
    title: entry.title,
    group: groupOf.get(entry.title)!,
    source: `${componentsDir}${entry.folder}/${entry.stem}.tsx`,
    summary: summary(outputs.get(`docs/${entry.title}.md`)!),
    ...(partFiles[entry.title] ? { parts: entry.title } : {}),
    ...(pageFunctions(entry.name).length > 0 ? { functions: pageFunctions(entry.name) } : {}),
  }))
  .sort((a, b) => catalogGroups.indexOf(a.group) - catalogGroups.indexOf(b.group));
outputs.set("site/src/docs/catalog.json", `${JSON.stringify(siteItems, null, 2)}\n`);

/** `OuroProvider` to `ouro-provider`: the address of an export's page that is not a registry item's. */
const kebab = (name: string) => name.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
// The site's other pages (site/src/docs/pages.ts): each documented export that is not a
// registry item's own page (Radio lives in radio-group, OuroProvider in lib/ouro), and each
// guide in docs/guides. A guide starts with `# Title` and a one-paragraph summary.
const itemTitles = new Set(siteItems.map((item) => item.title));
const exportPages = pages
  .filter((page) => !itemTitles.has(page.name))
  .map((page) => ({ name: kebab(page.name), title: page.name, kind: "export" as const, group: page.group, markdown: `docs/${page.name}.md`, summary: summary(outputs.get(`docs/${page.name}.md`)!.replace(/^# .*$/m, "")) }));
const guidesDir = join(root, "docs/guides");
const guidePages = (existsSync(guidesDir) ? readdirSync(guidesDir) : [])
  .filter((file) => file.endsWith(".md"))
  .sort()
  .map((file) => {
    const text = readFileSync(join(guidesDir, file), "utf8");
    const title = /^# (.+)\n\n(.+)\n/.exec(text);
    if (!title) throw new Error(`docs/guides/${file} must start with "# Title", a blank line and a one-paragraph summary.`);
    return { name: file.slice(0, -3), title: title[1]!, kind: "guide" as const, group: "Guides", markdown: `docs/guides/${file}`, summary: summary(text.replace(/^# .*$/m, "")) };
  });
const sitePages = [...guidePages, ...exportPages];
const taken = new Map<string, string>(siteItems.map((item) => [item.name, `the ${item.name} item`]));
for (const page of sitePages) {
  if (taken.has(page.name)) throw new Error(`${page.markdown} would be published at docs/${page.name}, the address of ${taken.get(page.name)}. Rename one.`);
  taken.set(page.name, page.markdown);
}
outputs.set("site/src/docs/pages.json", `${JSON.stringify(sitePages, null, 2)}\n`);

const catalogLines = () =>
  catalogGroups
    .map((group) => ({
      name: group,
      lines: pages.filter((page) => page.group === group).map((page) => `- **${page.name}** — ${page.described.summary} [Docs](docs/${page.name}.md)`),
    }))
    .filter((group) => group.lines.length > 0);

const readmeCatalog = [
  "<!-- catalog:start -->",
  GENERATED,
  "",
  ...catalogLines().flatMap((group) => [`### ${group.name}`, "", ...group.lines, ""]),
  "### Parts",
  "",
  `- **Parts** — building blocks for ${listOf([...partFamilies].sort())}, only for layouts the props cannot express. [Docs](docs/parts.md)`,
  "<!-- catalog:end -->",
].join("\n");

// README.md "Items": every item an app can add, from the manifests and lib/ouro, so a new
// component or helper can't leave the list behind.
const helperItems = readdirSync(join(root, "registry/ouro/lib/ouro"))
  .filter((file) => /\.tsx?$/.test(file) && !/\.test\.tsx?$/.test(file))
  .map((file) => `lib-${file.replace(/\.d\.ts$|\.tsx?$/, "")}`)
  .sort();
const readmeItems = [
  "<!-- items:start -->",
  GENERATED,
  "",
  `Components: ${components.map((entry) => code(entry.name)).join(", ")}.`,
  "",
  "Each component has an optional `<name>-tests` item (`button-tests`) with its Vitest browser tests, type tests, stories and Playwright spec; it also installs the tests of everything the component installs. `ouro-tests` adds every component with all of its tests, and `ouro-testing` is the test kit the `-tests` items bring.",
  "",
  "Once per app: `ouro-base`, the tokens every component needs in your stylesheet. Optional: `ouro-theme`, the Ouro look.",
  "",
  "Guardrails, optional: `ouro-census`, which holds every page and state of your app to a baseline of its visible controls, and `ouro-source-rules`, which finds the controls your source still builds by hand ([Guardrails guide](https://ourostack.github.io/ouro-ui/docs/guardrails/)).",
  "",
  `Helpers, one item per file in \`lib/ouro\`, each installed with the components that import it (you don't add them by name; \`ouro-lib\` is all of them, and a helper with tests has a \`<name>-tests\` item): ${helperItems.map(code).join(", ")}.`,
  "<!-- items:end -->",
].join("\n");

const readmePath = join(root, "README.md");
const readme = readFileSync(readmePath, "utf8");
if (!/<!-- catalog:start -->[\s\S]*<!-- catalog:end -->/.test(readme)) {
  throw new Error("README.md needs <!-- catalog:start --> and <!-- catalog:end --> markers.");
}
if (!/<!-- items:start -->[\s\S]*<!-- items:end -->/.test(readme)) {
  throw new Error("README.md needs <!-- items:start --> and <!-- items:end --> markers.");
}
if (!/<!-- upgrade:start -->[\s\S]*<!-- upgrade:end -->/.test(readme)) {
  throw new Error("README.md needs <!-- upgrade:start --> and <!-- upgrade:end --> markers.");
}
// "Upgrading from v0.1.0" is UPGRADING.md's body (scripts/upgrade-note.mjs), copied in whole,
// with the newest release in its addresses.
const release = latestRelease(root);
const upgrade = `<!-- upgrade:start -->\n${fillPlaceholder(noteBody(readFileSync(join(root, "UPGRADING.md"), "utf8")), release)}\n<!-- upgrade:end -->`;
outputs.set(
  "README.md",
  withRelease(
    readme
      .replace(/<!-- catalog:start -->[\s\S]*<!-- catalog:end -->/, () => readmeCatalog)
      .replace(/<!-- items:start -->[\s\S]*<!-- items:end -->/, () => readmeItems)
      .replace(/<!-- upgrade:start -->[\s\S]*<!-- upgrade:end -->/, () => upgrade),
    release,
  ),
);
// The other files whose install commands name the release.
for (const path of syncedFiles.filter((file) => file !== "README.md")) {
  outputs.set(path, withRelease(readFileSync(join(root, path), "utf8"), release));
}

// ---------------------------------------------------------------------------------------
// Write or check

const docsDir = join(outRoot, "docs");
const stray = existsSync(docsDir)
  ? readdirSync(docsDir)
      .filter((file) => file.endsWith(".md") && !outputs.has(`docs/${file}`))
      .map((file) => `docs/${file}`)
  : [];

if (check) {
  const stale = [...outputs]
    .filter(([path, content]) => {
      const file = join(outRoot, path);
      return (existsSync(file) ? readFileSync(file, "utf8") : "") !== content;
    })
    .map(([path]) => path);
  if (stale.length > 0 || stray.length > 0) {
    if (stale.length > 0) console.error(`${stale.join(", ")} ${stale.length === 1 ? "is" : "are"} stale.`);
    if (stray.length > 0) console.error(`${stray.join(", ")} documents no export.`);
    console.error("Run `pnpm run docs` and commit the result.");
    process.exit(1);
  }
  console.log("Docs are up to date.");
} else {
  for (const [path, content] of outputs) {
    const file = join(outRoot, path);
    mkdirSync(dirname(file), { recursive: true });
    writeFileSync(file, content);
  }
  for (const path of stray) rmSync(join(outRoot, path));
  console.log(`Wrote ${outputs.size} files${stray.length > 0 ? `, removed ${stray.join(", ")}` : ""}.`);
}
