// Ouro AX's reference pages, docs/ax/<item>.md, one per runtime ax item, generated from the JSDoc and the types in
// registry/ouro/ax/ through the TypeScript compiler API, as gen-docs.mts does for Ouro HX. gen-docs.mts writes them
// with everything else and `pnpm run docs --check` fails when one is stale.
//
// Each page: the item's purpose (its main file's first JSDoc comment), the install command, the files it installs and
// the items it brings, then every export: its JSDoc, its signature or declaration, and its example.
import { readdirSync } from "node:fs";
import { join } from "node:path";
import ts from "typescript";

const AX_DIR = "registry/ouro/ax";
const GENERATED = "<!-- Generated by scripts/ax-docs.mts from the JSDoc in registry/ouro/ax/. Do not edit; run `pnpm run docs`. -->";

/** The runtime files of each runtime ax item, by item name, as scripts/registry.mts groups them. */
export function axItems(root: string): Map<string, string[]> {
  const items = new Map<string, string[]>();
  for (const file of readdirSync(join(root, AX_DIR)).filter((name) => name.endsWith(".ts")).sort()) {
    const stem = file.replace(/\.ts$/, "");
    const name = stem === "example-cli" ? "ax-example" : `ax-${stem === "help" ? "cli" : stem}`;
    items.set(name, [...(items.get(name) ?? []), `${AX_DIR}/${file}`]);
  }
  return items;
}

/** A comment's text without its stars and its tags (everything from the first `@tag` line), with `{@link X}` as `X`. */
function commentText(comment: string): string {
  const lines = comment
    .replace(/^\/\*\*|\*\/$/g, "")
    .split("\n")
    .map((line) => line.replace(/^\s*\* ?/, ""));
  const tags = lines.findIndex((line) => line.startsWith("@"));
  return (tags === -1 ? lines : lines.slice(0, tags))
    .join("\n")
    .replace(/\{@link\s+([^}\s]+)\}/g, "`$1`")
    .trim();
}

/** Joins hard-wrapped lines into paragraphs, keeping lists and indented lines (usage examples) as they are. */
function paragraphs(text: string): string {
  return text
    .split(/\n\s*\n/)
    .map((block) => {
      const lines = block.split("\n");
      if (lines.some((line) => /^\s{2,}\S/.test(line))) return ["```sh", ...lines.map((line) => line.replace(/^\s{2}/, "")), "```"].join("\n");
      if (lines.some((line) => /^- /.test(line))) return lines.reduce<string[]>((out, line) => (/^- /.test(line) || !out.length ? [...out, line] : [...out.slice(0, -1), `${out.at(-1)} ${line.trim()}`]), []).join("\n");
      return lines.map((line) => line.trim()).join(" ");
    })
    .join("\n\n");
}

/** The first JSDoc comment in a file: its purpose. */
function filePurpose(source: ts.SourceFile): string {
  const match = source.text.match(/\/\*\*[\s\S]*?\*\//);
  return match ? paragraphs(commentText(match[0])) : "";
}

function jsDocOf(node: ts.Node): string {
  const docs = ts.getJSDocCommentsAndTags(node).filter(ts.isJSDoc);
  return docs.map((doc) => paragraphs(commentText(doc.getText()))).join("\n\n");
}

function exampleOf(node: ts.Node): string | undefined {
  const tag = ts.getJSDocTags(node).find((t) => t.tagName.text === "example");
  const text = typeof tag?.comment === "string" ? tag.comment : tag?.comment?.map((part) => part.text).join("");
  return text?.trim() || undefined;
}

/** A declaration's code as shown on the page: a function's signature, a type's whole declaration, a constant's type. */
function codeOf(node: ts.Node, checker: ts.TypeChecker, source: ts.SourceFile): string {
  const strip = (text: string) => text.replace(/\/\*\*[\s\S]*?\*\/\s*/g, "").replace(/^\s*\/\/.*\n/gm, "");
  if (ts.isFunctionDeclaration(node) && node.name) {
    const signature = checker.getSignatureFromDeclaration(node);
    return `function ${node.name.text}${signature ? checker.signatureToString(signature, undefined, ts.TypeFormatFlags.NoTruncation | ts.TypeFormatFlags.WriteArrowStyleSignature).replace(/^\((.*)\) => /, "($1): ") : "()"}`;
  }
  if (ts.isInterfaceDeclaration(node) || ts.isTypeAliasDeclaration(node)) return strip(node.getText(source));
  if (ts.isClassDeclaration(node) && node.name) return `class ${node.name.text}${node.heritageClauses ? ` ${node.heritageClauses.map((h) => h.getText(source)).join(" ")}` : ""}`;
  if (ts.isVariableDeclaration(node) && ts.isIdentifier(node.name)) {
    const type = node.type ? node.type.getText(source) : checker.typeToString(checker.getTypeAtLocation(node.name), undefined, ts.TypeFormatFlags.NoTruncation);
    return `const ${node.name.text}: ${type.length > 300 ? `${type.slice(0, 297)}...` : type}`;
  }
  return node.getText(source).split("\n")[0] ?? "";
}

/** The claim set as a table: tier, rule and what admitted each claim, from claims.ts itself. */
function claimsTable(root: string): string[] {
  const text = ts.sys.readFile(join(root, AX_DIR, "claims.ts")) ?? "";
  const body = text.slice(text.indexOf("claims: Object.freeze(["), text.indexOf("] as Claim[])"));
  const claims = [...body.matchAll(/^\s+(\{.*\}),?$/gm)].map((m) => JSON.parse(m[1]!) as { id: string; tier: string; rule: string; evidence: { basis: string; source: string; finding: string } });
  const cell = (s: string) => s.replace(/\|/g, "\\|");
  const basis = (e: { basis: string; source: string }) => (e.basis === "evaluation" ? `evaluation: [${e.source.split("/").at(-1)}](../../${e.source})` : e.basis === "hazard" ? "hazard" : `principle: ${cell(e.source)}`);
  return [
    "## The claims",
    "",
    "Must claims first. `node lib/ouro/ax/xray.ts claims` prints them, with their checks; [the claims guide](../guides/ax-claims.md) says how a claim is admitted.",
    "",
    "| Claim | Tier | Rule | Admitted by |",
    "| --- | --- | --- | --- |",
    ...[...claims].sort((a, b) => (a.tier === b.tier ? 0 : a.tier === "must" ? -1 : 1)).map((c) => `| \`${c.id}\` | ${c.tier} | ${cell(c.rule)} | ${basis(c.evidence)} |`),
  ];
}

/** One page per runtime ax item, by path (`docs/ax/<item>.md`). `release` is the tag the install command names. */
export function axDocs(root: string, release: string): Map<string, string> {
  const items = axItems(root);
  const files = [...items.values()].flat().map((file) => join(root, file));
  const program = ts.createProgram(files, { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext, moduleResolution: ts.ModuleResolutionKind.Bundler, allowImportingTsExtensions: true, noEmit: true, strict: true, types: ["node"] });
  const checker = program.getTypeChecker();
  const pages = new Map<string, string>();
  const importsOf = (file: string) => [...(program.getSourceFile(join(root, file))?.text.matchAll(/from "\.\/([\w-]+)\.ts"/g) ?? [])].map((m) => m[1]!);
  for (const [name, paths] of items) {
    const main = paths.find((path) => path.endsWith(`/${name.slice(3)}.ts`)) ?? paths[0]!;
    const brings = [...new Set(paths.flatMap(importsOf).map((stem) => (stem === "help" ? "ax-cli" : stem === "example-cli" ? "ax-example" : `ax-${stem}`)))].filter((dep) => dep !== name).sort();
    const lines = [
      GENERATED,
      "",
      `# ${name}`,
      "",
      filePurpose(program.getSourceFile(join(root, main))!),
      "",
      "```sh",
      `npx shadcn@latest add ourostack/ouro-ui/${name}#${release}`,
      "```",
      "",
      `It installs ${paths.map((path) => `\`lib/ouro/ax/${path.slice(AX_DIR.length + 1)}\``).join(" and ")}${brings.length ? `, with ${brings.map((dep) => `\`${dep}\``).join(", ")}` : ""}. Its tests are \`${name}-tests\`. Every item runs on Node 22.18 or later as it is copied: the files import each other as \`./<file>.ts\`. The [Ouro AX guide](../guides/ax.md) shows how they fit together.`,
    ];
    for (const path of paths) {
      const source = program.getSourceFile(join(root, path))!;
      const moduleSymbol = checker.getSymbolAtLocation(source)!;
      const exported = checker.getExportsOfModule(moduleSymbol).map((symbol) => (symbol.flags & ts.SymbolFlags.Alias ? checker.getAliasedSymbol(symbol) : symbol));
      if (!exported.length) continue;
      lines.push("", paths.length > 1 ? `## Exports of ${path.slice(AX_DIR.length + 1)}` : "## Exports");
      for (const symbol of exported.sort((a, b) => a.getName().localeCompare(b.getName()))) {
        const declaration = symbol.declarations?.[0];
        if (!declaration || declaration.getSourceFile() !== source) continue;
        const node = ts.isVariableDeclaration(declaration) ? declaration.parent.parent : declaration;
        const doc = jsDocOf(node);
        lines.push("", `### \`${symbol.getName()}\``, "");
        if (doc) lines.push(doc, "");
        lines.push("```ts", codeOf(declaration, checker, source), "```");
        const example = exampleOf(node);
        if (example) lines.push("", "Example:", "", "```ts", example, "```");
      }
    }
    if (name === "ax-claims") lines.push("", ...claimsTable(root));
    pages.set(`docs/ax/${name}.md`, `${lines.join("\n")}\n`);
  }
  return pages;
}
