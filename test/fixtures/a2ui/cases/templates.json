{
  "description": "A list template over the data model with relative and absolute paths, a bound List and a bound DescriptionList.",
  "catalog": "catalog.json",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "plan",
        "catalogId": "https://ui.ouroboros.bot/a2ui/v1/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "plan",
        "components": [
          {
            "id": "root",
            "component": "Stack",
            "gap": "large",
            "children": {
              "componentId": "day",
              "path": "/days"
            }
          },
          {
            "id": "day",
            "component": "Card",
            "children": [
              "day_name",
              "meals",
              "facts"
            ]
          },
          {
            "id": "day_name",
            "component": "Heading",
            "text": {
              "@path": "name"
            },
            "level": 2
          },
          {
            "id": "meals",
            "component": "List",
            "items": {
              "@path": "meals"
            },
            "ordered": true
          },
          {
            "id": "facts",
            "component": "DescriptionList",
            "items": [
              {
                "term": "Cook",
                "detail": {
                  "@path": "cook"
                }
              },
              {
                "term": "Week",
                "detail": {
                  "@path": "/week"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "plan",
        "value": {
          "week": "Week 46",
          "days": [
            {
              "name": "Monday",
              "meals": [
                "Oats",
