// Where Spoonjoy (https://spoonjoy.app, source https://github.com/spoonjoy/spoonjoy-v2) uses each
// Ouro HX component, for the docs pages' "In Spoonjoy" links and the landing page's showcase:
//
//   node site/scripts/spoonjoy.mts            fetches Spoonjoy's public pages and its
//                                             /ouro-provenance.json, and writes
//                                             site/src/docs/spoonjoy.json
//
// A page counts only when its server HTML, fetched signed out, holds the component's root marker
// (data-ouro="<item>"), so every live link opens a page that shows the component to anyone. The
// source files come from the provenance file's `renders`, which Spoonjoy derives from its imports.
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const repo = join(dirname(fileURLToPath(import.meta.url)), "../..");
export const OUT = join(repo, "site/src/docs/spoonjoy.json");
export const APP = "https://spoonjoy.app";
export const SOURCE = "https://github.com/spoonjoy/spoonjoy-v2";

/** Spoonjoy's public pages, in the order the docs prefer them, with the name a link shows. */
export const PAGES: { path: string; label: string }[] = [
  { path: "/", label: "Home" },
  { path: "<recipe>", label: "A recipe" },
  { path: "/recipes", label: "Recipes" },
  { path: "/search", label: "Search" },
  { path: "/test-kitchen", label: "Test kitchen" },
  { path: "/developers", label: "Developers" },
  { path: "/developers/playground", label: "API playground" },
  { path: "/login", label: "Sign in" },
  { path: "/signup", label: "Sign up" },
  { path: "/support", label: "Support" },
  { path: "/privacy", label: "Privacy" },
  { path: "/terms", label: "Terms" },
];

/** At most this many live pages and source files per component. */
export const MAX_PAGES = 3;
export const MAX_SOURCES = 3;

export interface Use {
  pages: { url: string; label: string }[];
  sources: string[];
}

export interface Spoonjoy {
  $comment: string;
  ouroTag: string;
  guide: string;
  items: Record<string, Use>;
}

/** The registry:ui items a page's HTML shows, by their root marker. */
export function markers(html: string, items: Set<string>): Set<string> {
  const found = new Set<string>();
  for (const match of html.matchAll(/data-ouro="([a-z-]+)"/g)) if (items.has(match[1]!)) found.add(match[1]!);
  return found;
}

/** Each item's source files in Spoonjoy, most used first, from the provenance file's renders. */
export function sources(provenance: { root: { renders: Record<string, string[]> }; routes: { renders?: Record<string, string[]> }[] }): Map<string, string[]> {
  const counts = new Map<string, Map<string, number>>();
  for (const renders of [provenance.root.renders, ...provenance.routes.map((route) => route.renders ?? {})]) {
    for (const [item, files] of Object.entries(renders)) {
      const byFile = counts.get(item) ?? new Map<string, number>();
      for (const file of files) byFile.set(file, (byFile.get(file) ?? 0) + 1);
      counts.set(item, byFile);
    }
  }
  return new Map(
    [...counts].map(([item, byFile]) => [item, [...byFile].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([file]) => file)]),
  );
}

/** The data the docs read: each item Spoonjoy shows on a public page or renders in its source. */
export function build(
  shown: { url: string; label: string; items: Set<string> }[],
  bySource: Map<string, string[]>,
  items: string[],
  ouroTag: string,
  guide: string,
): Spoonjoy {
  const out: Record<string, Use> = {};
  for (const item of items) {
    const pages = shown.filter((page) => page.items.has(item)).slice(0, MAX_PAGES).map(({ url, label }) => ({ url, label }));
    const files = (bySource.get(item) ?? []).slice(0, MAX_SOURCES).map((file) => `${SOURCE}/blob/main/${file}`);
    if (pages.length || files.length) out[item] = { pages, sources: files };
  }
  return {
    $comment: "Generated by node site/scripts/spoonjoy.mts from Spoonjoy's public pages and /ouro-provenance.json; do not edit.",
    ouroTag,
    guide,
    items: out,
  };
}

async function text(url: string): Promise<string> {
  const response = await fetch(url, { redirect: "manual", headers: { "user-agent": "ouro-ui-docs (+https://ui.ouro.bot/)" } });
  if (response.status !== 200) throw new Error(`${url} answered ${response.status}, not 200 (signed out)`);
  return response.text();
}

async function main(): Promise<void> {
  const registry = JSON.parse(readFileSync(join(repo, "registry.json"), "utf8")) as { items: { name: string; type: string }[] };
  const items = registry.items.filter((item) => item.type === "registry:ui").map((item) => item.name);
  const known = new Set(items);
  const provenance = JSON.parse(await text(`${APP}/ouro-provenance.json`));

  // The recipe with the most components, of the first recipes in Spoonjoy's sitemap.
  const sitemap = await text(`${APP}/sitemap.xml`);
  const recipes = [...sitemap.matchAll(/<loc>(https:\/\/spoonjoy\.app\/recipes\/[\w-]+)<\/loc>/g)].map((match) => match[1]!).slice(0, 12);
  let recipe = { url: "", items: new Set<string>() };
  for (const url of recipes) {
    const found = markers(await text(url), known);
    if (found.size > recipe.items.size) recipe = { url, items: found };
  }
  if (!recipe.url) throw new Error("Spoonjoy's sitemap lists no recipe");

  const shown = [];
  for (const page of PAGES) {
    if (page.path === "<recipe>") shown.push({ url: recipe.url, label: page.label, items: recipe.items });
    else shown.push({ url: `${APP}${page.path === "/" ? "/" : page.path}`, label: page.label, items: markers(await text(`${APP}${page.path}`), known) });
  }

  const data = build(shown, sources(provenance), items, provenance.ouroTag, provenance.guide);
  writeFileSync(OUT, `${JSON.stringify(data, null, 2)}\n`);
  const live = Object.values(data.items).filter((use) => use.pages.length).length;
  console.log(`Wrote ${Object.keys(data.items).length} components (${live} on a public page) from ${shown.length} pages to site/src/docs/spoonjoy.json.`);
}

if (process.argv[1] === fileURLToPath(import.meta.url)) await main();
