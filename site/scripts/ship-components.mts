// Which Ouro HX components the site's own ship pages show (the home page and the Nautilus's page),
// for the docs pages' "On this site" links, which open X-ray pointing the component out:
//
//   node site/scripts/ship-components.mts   renders both pages on the server, as the prerender
//                                           does, and writes site/src/docs/ship-components.json
//
// `pnpm site:build` runs it first, so the docs always link the components the built pages show,
// chapters added later included, with no list kept by hand. A component counts on a page when the
// page's HTML holds its root marker (data-ouro="<name>") outside anything the page keeps hidden,
// and X-ray would show it: an overlay's wrappers and a part apart from its component name their
// item, as X-ray reads them (itemFor). The voyage e2e opens each one with X-ray to prove it.
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { itemFor } from "../../registry/ouro/components/ouro/inspector/inspector-styles.ts";
import { SHIP_PAGES } from "../src/docs/ships.ts";

export { SHIP_PAGES };

const repo = join(dirname(fileURLToPath(import.meta.url)), "../..");
export const OUT = join(repo, "site/src/docs/ship-components.json");

/**
 * Components a page renders that X-ray never shows there: the Toaster's region is empty until a
 * toast appears, and X-ray is X-ray's own.
 */
export const UNSEEN = new Set(["toaster", "inspector"]);

export interface ShipComponents {
  $comment: string;
  items: Record<string, string[]>;
}

/** Elements that never hold content, so they open no level of the page. */
const VOID = new Set(["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"]);

/**
 * The registry items whose root marker a page's HTML holds, by X-ray's reading of each name. A
 * root the page keeps hidden (inside an element with the `hidden` attribute, like a closed
 * Collapsible's panel) counts only once it shows, so it is left out; so is any script, style or
 * template content. React's server HTML is well formed, so walking its tags is enough.
 */
export function shown(html: string, items: Set<string>): Set<string> {
  const found = new Set<string>();
  const open: { tag: string; hidden: boolean }[] = [];
  let hidden = 0;
  const tags = /<!--[\s\S]*?-->|<(\/?)([a-zA-Z][\w-]*)((?:[^>"']|"[^"]*"|'[^']*')*)>/g;
  for (let match = tags.exec(html); match; match = tags.exec(html)) {
    const [, closing, name, attributes = ""] = match;
    if (!name) continue;
    const tag = name.toLowerCase();
    if (closing) {
      const at = open.findLastIndex((element) => element.tag === tag);
      if (at === -1) continue;
      for (const element of open.splice(at)) if (element.hidden) hidden--;
      continue;
    }
    if (tag === "script" || tag === "style" || tag === "template") {
      const end = html.indexOf(`</${tag}>`, tags.lastIndex);
      tags.lastIndex = end === -1 ? html.length : end + tag.length + 3;
      continue;
    }
    const marker = /\sdata-ouro="([a-z0-9-]+)"/.exec(attributes)?.[1];
    if (marker && hidden === 0) {
      const item = itemFor(marker);
      if (item !== null && items.has(item) && !UNSEEN.has(item)) found.add(item);
    }
    if (VOID.has(tag) || attributes.trimEnd().endsWith("/")) continue;
    const isHidden = /(?:^|\s)hidden(?:=|\s|$)/.test(attributes);
    open.push({ tag, hidden: isHidden });
    if (isHidden) hidden++;
  }
  return found;
}

/** Each item the ship pages show, with the paths of the pages that show it in {@link SHIP_PAGES} order, items sorted. */
export function build(htmlByPath: Record<string, string>, items: Set<string>): ShipComponents {
  const byItem = new Map<string, string[]>();
  for (const { path } of SHIP_PAGES) {
    for (const item of shown(htmlByPath[path] ?? "", items)) byItem.set(item, [...(byItem.get(item) ?? []), path]);
  }
  return {
    $comment: "Generated by node site/scripts/ship-components.mts (pnpm site:build runs it) from the server-rendered home and Nautilus pages; do not edit.",
    items: Object.fromEntries([...byItem].sort(([a], [b]) => a.localeCompare(b))),
  };
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  const { createServer } = await import("vite");
  const server = await createServer({ configFile: join(repo, "site/vite.config.ts"), server: { middlewareMode: true, hmr: false }, appType: "custom", logLevel: "error" });
  try {
    const { render } = (await server.ssrLoadModule("/src/entry-server.tsx")) as { render: (path: string) => Promise<string> };
    const registry = JSON.parse(readFileSync(join(repo, "registry.json"), "utf8")) as { items: { name: string; type: string }[] };
    const items = new Set(registry.items.filter((item) => item.type === "registry:ui").map((item) => item.name));
    const htmlByPath: Record<string, string> = {};
    for (const { path } of SHIP_PAGES) htmlByPath[path] = await render(path);
    const out = build(htmlByPath, items);
    const text = `${JSON.stringify(out, null, 2)}\n`;
    const before = (() => {
      try {
        return readFileSync(OUT, "utf8");
      } catch {
        return "";
      }
    })();
    if (text !== before) writeFileSync(OUT, text);
    console.log(`${Object.keys(out.items).length} components on the ship pages${text === before ? "" : `, written to ${OUT.slice(repo.length + 1)}`}`);
  } finally {
    await server.close();
  }
}
