    { "name": "selected", "feedback": "selection", "when": "A choice changed: a tab, a segment, a picker row." },
    { "name": "checked", "feedback": "selection", "when": "Something ticked off: an ingredient, a list item, a to-do." },
    { "name": "stepped", "feedback": "selection", "when": "A stepper moved one step." },
    { "name": "turned", "feedback": "impact", "weight": "light", "intensity": 1, "when": "A page or step turned." },
    { "name": "started", "feedback": "impact", "weight": "medium", "intensity": 1, "when": "Something began that runs on: a timer, a cook session, a download." },
    { "name": "finished", "feedback": "success", "when": "Something finished well: a timer ran out, a book or recipe finished." },
    { "name": "warned", "feedback": "warning", "when": "About to do something that can't be undone." },
    { "name": "failed", "feedback": "error", "when": "It didn't work." }
  ]
