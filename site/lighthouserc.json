{
  "ci": {
    "collect": {
      "startServerCommand": "node site/scripts/serve-pages.mjs 4180",
      "startServerReadyPattern": "Serving site/dist",
      "url": ["https://127.0.0.1:4180/", "https://127.0.0.1:4180/nautilus/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --ignore-certificate-errors",
        "onlyCategories": ["performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".tmp/lhci" }
  }
}
