{
  "name": "ouro-ui",
  "private": true,
  "version": "0.0.1",
  "description": "Ouro UI: a shadcn registry of React components with handcrafted interactions, designed for coding agents to use correctly without a skill.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ourostack/ouro-ui.git"
  },
  "homepage": "https://github.com/ourostack/ouro-ui",
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18"
    }
  },
  "scripts": {
    "docs": "node scripts/gen-docs.mts",
    "test": "vitest run --coverage",
    "test:visual": "CI_VISUAL=1 vitest run --project visual",
    "typecheck": "tsc --noEmit && tsc -p scripts/fixtures/no-node-types",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:scripts": "node --test scripts/dev-strip.test.mjs scripts/gen-docs.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/react": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "motion": "14.0.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
