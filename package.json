{
  "name": "@ouro.bot/ui",
  "version": "0.0.1",
  "description": "Ouro UI: React components with handcrafted interactions, designed for coding agents to use correctly without a skill.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ourostack/ouro-ui.git"
  },
  "homepage": "https://github.com/ourostack/ouro-ui",
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parts": {
      "types": "./dist/parts.d.ts",
      "import": "./dist/parts.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "theme": "node scripts/build-theme.mts",
    "build": "pnpm theme && tsdown && tailwindcss -i src/styles.css -o dist/styles.css",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:package": "node scripts/check-package.mjs",
    "test:scripts": "node --test scripts/check-package.test.mjs scripts/build-theme.test.mjs"
  },
  "peerDependencies": {
    "motion": "^12.29.0 || ^13 || ^14",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "motion": "14.0.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
