+}
+
+/** A conversation of pictures that loads older pages as the reader scrolls back to its start. */
+function PictureChat() {
+  const [pages, setPages] = useState(1);
+  const [loading, setLoading] = useState(false);
+  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
+  useEffect(() => () => clearTimeout(timer.current), []);
+  const hasOlder = pages < 3;
+  return (
+    <Surface>
+      <MessageList
+        label="Bread club"
+        style={{ height: 520 }}
+        hasOlder={hasOlder}
+        loadingOlder={loading}
+        onScrollCapture={(event) => {
+          if (!hasOlder || loading || (event.target as HTMLElement).scrollTop > 160) return;
+          setLoading(true);
+          timer.current = setTimeout(() => {
+            setPages((count) => count + 1);
+            setLoading(false);
+          }, 400);
+        }}
+      >
+        {Array.from({ length: pages }, (_, index) => picturePage(pages - index)).flat()}
+      </MessageList>
+    </Surface>
+  );
+}
+
+/**
+ * Pictures in a conversation: avatars, photos alone and in mosaics, a photo whose size the app
+ * does not know, a file and an image emoji. Each holds its box from the first frame, so nothing
+ * moves as the pictures arrive, at the newest message or while older pages load above.
+ */
+export const Pictures: Story = {
+  args: { label: "Bread club", children: null },
+  render: () => <PictureChat />,
+};
